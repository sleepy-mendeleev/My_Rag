# Copy this template to .env in the PROJECT ROOT.
# The backend currently loads <project>/.env, not configs/.env.

# Milvus: start the database separately before running the backend.
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
COLLECTION_NAME=agent_rag

# DashScope: fill in your own key locally; never commit the real .env.
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Retrieval: L2 distance is smaller for closer vectors.
# This is an experimental threshold for the current model and corpus.
L2_MAX_DISTANCE=14000

# The current frontend calls http://localhost:5000/api/vector.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Semantic splitting is opt-in; tune the threshold for your documents.
SEMANTIC_SPLIT_ENABLED=false
SEMANTIC_SIMILARITY_THRESHOLD=0.45